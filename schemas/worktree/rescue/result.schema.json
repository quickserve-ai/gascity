{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc worktree rescue --json success result",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command",
    "action",
    "path",
    "repo",
    "bead_id",
    "rescue_ref",
    "rescue_sha",
    "wip"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "ok": { "const": true },
    "command": { "const": "worktree rescue" },
    "action": { "const": "rescue" },
    "path": { "type": "string" },
    "repo": { "type": "string" },
    "bead_id": { "type": "string" },
    "head": { "type": "string" },
    "rescue_ref": { "type": "string", "pattern": "^refs/rescue/" },
    "rescue_sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "wip": { "type": "boolean" },
    "sediment": { "type": "array", "items": { "type": "string" } },
    "taint": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
