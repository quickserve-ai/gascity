load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "notify",
    srcs = ["notify.go"],
    importpath = "github.com/gastownhall/gascity/internal/notify",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "notify_test",
    srcs = [
        "notify_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    embed = [":notify"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
