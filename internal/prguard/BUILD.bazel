load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "prguard",
    srcs = ["prguard.go"],
    importpath = "github.com/gastownhall/gascity/internal/prguard",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/beadmeta",
    ],
)

go_test(
    name = "prguard_test",
    srcs = [
        "prguard_test.go",
        "testenv_import_test.go",
    ],
    data = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    embed = [":prguard"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
