load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "mail",
    srcs = [
        "crosscity.go",
        "crosscity_roster.go",
        "crosstown.go",
        "fake.go",
        "mail.go",
        "resolve.go",
        "unconfirmed.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/mail",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/session",
    ],
)

go_test(
    name = "mail_test",
    srcs = [
        "crosscity_roster_test.go",
        "crosscity_test.go",
        "crosstown_test.go",
        "fake_conformance_test.go",
        "order_sender_test.go",
        "resolve_test.go",
        "testenv_import_test.go",
    ],
    embed = [":mail"],
    deps = [
        "//internal/mail/mailtest",
        "//internal/session",
        "//internal/testenv",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
