# Pinned dependency versions for CI and Docker builds.
# See docs/image-dependency-versioning.md for the versioning strategy.
#
# Update these when bumping automation/image pins. The internal/deps package
# defines minimum compatible versions (may lag behind these pins).

DOLT_VERSION=2.1.7
# BD_REPO is the repository the source-built bd cell clones (ci.yml
# contract-acceptance-current). Release tarballs (BD_VERSION, BD_PREV_VERSION)
# are upstream gastownhall/beads releases and stay so: install-bd-archive.sh
# names that repository itself; the fork's fleet releases publish raw binaries
# (bd-<tag>-<platform>, .go-version-m, SHA256SUMS; v1.1.1-fleet.20260910 since
# 2026-09-10), never tarballs, so the tarball paths stay on upstream.
BD_REPO=quickserve-ai/beads
BD_VERSION=v1.1.0
BR_VERSION=0.1.20

# Cross-version contract-test matrix pins.
# See engdocs/design/beads-gascity-contract-test-system.md.
# BD_PREV_VERSION is the minimum-supported bd: a published release whose tarball
# SHA is pinned in .github/scripts/install-bd-archive.sh (no API fallback on the
# required path). BD_CURRENT_VERSION is the bd the fleet runs; the matrix
# builds it from beads source at BD_CURRENT_REF (a BD_REPO commit) rather than
# from a tarball. On carry/operational both equal go.mod's replace target
# -- the beads fork revision gc links and install-bd-lockstep.sh builds -- and
# move with it (scripts/beads_module_pin_test.go, CARRY.md "Beads pin").
BD_PREV_VERSION=v1.0.4
BD_CURRENT_VERSION=v1.1.1-fleet.20260910
BD_CURRENT_REF=1370260e6f479099da6fbe789201fe040b200167
